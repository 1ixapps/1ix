# Copy to .env.local. Never commit .env.local or real credentials.
# From Supabase Connect > Transaction pooler. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
# TLS is required by default. "disable" is allowed only outside production for local PostgreSQL.
DATABASE_SSLMODE=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Supabase Auth uses the public key below; do not put a service-role key here.
SUPABASE_PUBLISHABLE_KEY=
# Optional legacy public key instead of publishable:
SUPABASE_ANON_KEY=
# Storage and explicit Auth import need a server-only secret key.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=business-media
SITE_URL=https://1ix.ir
NEXT_PUBLIC_SITE_URL=https://1ix.ir
# Leave API origin empty: the UI calls /api on the same Next.js deployment.
NEXT_PUBLIC_API_ORIGIN=
CORS_ORIGINS=
# Auth emails are sent by Supabase. Configure Email confirmation and Custom SMTP in its dashboard.
# Optional server-controlled SMS adapter: POST {phone,code}, Bearer secret; non-2xx means failure.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_SECRET=
# Used only by the explicit admin provisioning command, not on every deployment.
ADMIN_EMAIL=
# One-time import only. Do not configure these on Vercel.
MONGO_URL=
DB_NAME=
# Required only for legacy import: absolute path of the old uploads folder outside this repository.
LEGACY_UPLOAD_DIR=
# Old absolute upload origins, comma separated; relative /api/uploads URLs work automatically.
LEGACY_UPLOAD_ORIGINS=
